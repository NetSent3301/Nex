# ── Hooks de lifecycle / extensibilidad ────────────────────────────
# Los hooks reciben un único argumento ctx (dict). Eventos:
#   session_start, turn_start, tool_before, tool_after, turn_end, session_end
_HOOKS: dict[str, list] = {}


def register_hook(event: str, fn) -> None:
    _HOOKS.setdefault(event, []).append(fn)


def run_hooks(event: str, **ctx) -> None:
    for fn in _HOOKS.get(event, []):
        try:
            fn(ctx)
        except Exception as e:
            logger.warning("Hook '%s' falló: %s", event, e)


def _write_trace(entry: dict) -> None:
    try:
        os.makedirs(os.path.dirname(TRACES_FILE), exist_ok=True)
        with open(TRACES_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _hook_trace_tool(ctx: dict) -> None:
    args = json.dumps(ctx.get("args", {}), ensure_ascii=False, default=str)
    _write_trace({
        "event": "tool_after",
        "ts": time.time(),
        "tool": ctx.get("name"),
        "args": args[:800],
        "duration_s": round(float(ctx.get("duration_s", 0)), 3),
        "success": bool(ctx.get("success", True)),
        "issues": ctx.get("issues", []),
    })


register_hook("tool_after", _hook_trace_tool)


def load_user_hooks() -> int:
    """Carga hooks externos (logging/CI/políticas) sin tocar el código de nex.

    Fuente: $NEX_HOOKS o ~/.config/nex/hooks.py. El módulo expone
    `HOOKS = {"evento": [fn], ...}` y cada fn recibe ctx (dict).
    """
    path = os.environ.get("NEX_HOOKS") or os.path.expanduser("~/.config/nex/hooks.py")
    if not os.path.isfile(path):
        return 0
    import importlib.util
    spec = importlib.util.spec_from_file_location("nex_user_hooks", path)
    mod = importlib.util.module_from_spec(spec)
    if spec.loader is None:
        return 0
    spec.loader.exec_module(mod)
    mapping = getattr(mod, "HOOKS", None) or {}
    count = 0
    for event, fns in mapping.items():
        for fn in (fns if isinstance(fns, list) else [fns]):
            if callable(fn):
                register_hook(event, fn)
                count += 1
    return count


