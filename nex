def validate_tool_result(name: str, result, max_chars: int = MAX_TOOL_OUTPUT_CHARS):
    """Valida el output de una tool: forma, fallo y tamaño antes de confiarlo al modelo."""
    issues: list[str] = []
    if not isinstance(result, dict):
        issues.append("salida no es dict; envuelta en {'result': ...}")
        result = {"result": result}

    def _cap(v):
        if isinstance(v, str):
            if len(v) > max_chars:
                issues.append(f"salida truncada ({len(v)} → {max_chars} chars)")
                return v[:max_chars] + "\n...[truncado: {0} chars omitidos]".format(len(v) - max_chars)
            return v
        if isinstance(v, dict):
            return {k: _cap(x) for k, x in v.items()}
        if isinstance(v, list):
            return [_cap(x) for x in v]
        return v

    if result.get("success") is False:
        issues.append("la tool reportó fallo")
    result = _cap(result)
    return result, list(dict.fromkeys(issues))


