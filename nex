class Spinner:
    """Simple animated spinner running on a background thread."""

    def __init__(self, msg="Pensando...", frames=None, interval=0.08):
        self.msg = msg
        self.frames = frames or SPIN_FRAMES
        self.interval = interval
        self.running = False
        self.thread = None

    def start(self, msg=None):
        if msg:
            self.msg = msg
        if self.running:
            return
        self.running = True
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def stop(self):
        if not self.running:
            return
        self.running = False
        if self.thread:
            self.thread.join(timeout=0.3)
        try:
            width = os.get_terminal_size().columns
        except OSError:
            width = 80
        sys.stdout.write("\r" + " " * width + "\r")
        sys.stdout.flush()

    def _spin(self):
        i = 0
        while self.running:
            frame = self.frames[i % len(self.frames)]
            sys.stdout.write(f"\r  {Y}{frame}{RS} {self.msg}  ")
            sys.stdout.flush()
            time.sleep(self.interval)
            i += 1


class TermInput:
    """Editor de línea con historial (flechas ↑/↓), backspace, Ctrl+D y menú
    flotante de autocompletado para comandos (escribir '/') que se dibuja
    encima del prompt en una pequeña ventana con bordes:

    - ↑/↓ con menú abierto navegan la selección (sin menú, el historial).
    - Tab completa la selección (o cicla entre las que coinciden).
    - Enter acepta la selección y envía el comando.
    - Esc oculta el menú.

    Corre en el thread de lectura. Dibuja el prompt solo cuando el bucle
    principal llama a `ask()` (para no intercalar el prompt con la salida del
    agente). Mientras el agente está trabajando, lo escrito se muestra inline
    sin redibujar.
    """

    def __init__(self, prompt: str = "Tu> "):
        self.prompt = prompt
        self.history: list[str] = []
        self.buf = ""
        self.idx = 0
        self._waiting = True
        self._hidden = False
        self._sel = 0
        self._open_rows = 0

    def ask(self) -> None:
        self._waiting = False
        self._draw()

    def _draw(self) -> None:
        self._clear_area()
        sys.stdout.write("\r" + self.prompt + self.buf + "\x1b[K")
        menu = self._menu_lines()
        if menu:
            n = len(menu)
            sys.stdout.write(f"\x1b[{n}A")
            for i, line in enumerate(menu):
                sys.stdout.write("\r" + line + "\x1b[K")
                if i < n - 1:
                    sys.stdout.write("\n")
            sys.stdout.write("\r\n")
            self._open_rows = n
        sys.stdout.flush()

    def _clear_area(self) -> None:
        rows = self._open_rows
        if rows:
            sys.stdout.write(f"\x1b[{rows}A")
            for _ in range(rows):
                sys.stdout.write("\x1b[2K\x1b[B")
            sys.stdout.write("\r")
        self._open_rows = 0
        sys.stdout.flush()

    def _matches(self) -> list[str]:
        return [c for c in SLASH_COMMANDS if c.startswith(self.buf)]

    def _menu_lines(self) -> list[str]:
        if self._waiting or self._hidden or not self.buf.startswith("/"):
            return []
        matches = self._matches()
        if not matches:
            return []
        try:
            cols = max(os.get_terminal_size().columns, 24)
            lines_term = max(os.get_terminal_size().lines, 6)
        except (OSError, ValueError):
            cols, lines_term = 60, 24
        max_rows = 5
        self._sel = min(max(self._sel, 0), len(matches) - 1)
        first = (self._sel // max_rows) * max_rows
        page = matches[first : first + max_rows]

        inner = 4 + max(len(f"/{m[1:]}") for m in page) if page else 8
        if len(matches) > len(page):
            inner = max(inner, 4 + len(f"{len(page)}/{len(matches)}"))
        inner = min(inner, max(cols - 2, 8))
        if lines_term < 7:
            return []

        box = [f"{M}┌{'─' * inner}┐{RS}"]
        for i, m in enumerate(page):
            idx = first + i
            name = f"/{m[1:]}"
            sel = idx == self._sel
            marker = "▸ " if sel else "  "
            pad = inner - 2 - len(marker) - len(name)
            cell = f"{INV if sel else ''}{marker}{C}{name}{RS}{' ' * pad}"
            box.append(f"{M}│{RS} {cell} {M}│{RS}")
        if len(matches) > len(page):
            info = f"  {len(page)}/{len(matches)} · más"
            pad = inner - 2 - len(info)
            box.append(f"{M}│{RS} {M}{info}{RS}{' ' * pad} {M}│{RS}")
        box.append(f"{M}└{'─' * inner}┘{RS}")
        return box

    def _has_menu(self) -> bool:
        return not self._waiting and not self._hidden and self.buf.startswith("/") and bool(self._matches())

    def _accept_selection(self) -> None:
        matches = self._matches()
        if matches:
            self._sel = min(max(self._sel, 0), len(matches) - 1)
            self.buf = matches[self._sel]
            self._hidden = True
        self._sel = 0

    def _submit(self) -> str:
        if self._has_menu():
            self._accept_selection()
        else:
            self._sel = 0
        self._clear_area()
        line = self.buf
        sys.stdout.write("\r\n")
        sys.stdout.flush()
        self.buf = ""
        self._waiting = True
        if line and (not self.history or self.history[-1] != line):
            self.history.append(line)
        self.idx = len(self.history)
        return line

    def _navigate(self, delta: int) -> None:
        new = min(max(self.idx + delta, 0), len(self.history))
        if new == self.idx:
            return
        self.idx = new
        self.buf = self.history[new] if new < len(self.history) else ""

    def run(self, put) -> None:
        fd = sys.stdin.fileno()
        try:
            old = tty.tcgetattr(fd)
            tty.setcbreak(fd)
            atexit.register(_restore_term, old)
        except Exception:
            old = None
        if old is None:
            while True:
                line = sys.stdin.readline()
                if not line:
                    put(None)
                    return
                put(line.rstrip("\n"))
            return

        pending = b""
        while True:
            try:
                data = os.read(fd, 4096)
            except InterruptedError:
                continue
            if not data:
                put(None)
                return
            pending += data
            while pending:
                ch = pending[0]
                if ch == 27:
                    # Secuencia de escape: solo consumir CSI (`ESC[`) o SS3
                    # (`ESCO`) completas; un ESC suelto se descarta sin comerse
                    # los bytes que el usuario escriba después.
                    if len(pending) >= 2 and pending[1] == 91:
                        idx = 2
                        while idx < len(pending) and pending[idx] not in b"~@ABCDEFGHIJKLMNOPQRSTUVWXYZ":
                            idx += 1
                        if idx < len(pending):
                            seq = pending[: idx + 1]
                            pending = pending[idx + 1:]
                            if not self._waiting:
                                if seq in (b"\x1b[A", b"\x1b[B"):
                                    if self._has_menu():
                                        matches = self._matches()
                                        if seq == b"\x1b[A":
                                            self._sel = (self._sel - 1) % len(matches)
                                        else:
                                            self._sel = (self._sel + 1) % len(matches)
                                    else:
                                        self._navigate(-1 if seq == b"\x1b[A" else 1)
                                    self._draw()
                        else:
                            break  # CSI incompleta: esperar más bytes
                    elif len(pending) >= 3 and pending[1] == 79:
                        pending = pending[3:]
                    elif not self._waiting:
                        pending = pending[1:]
                        self._hidden = True
                        self._draw()
                    else:
                        pending = pending[1:]
                elif ch in (0x0D, 0x0A):
                    pending = pending[1:]
                    put(self._submit())
                elif ch == 0x09:
                    pending = pending[1:]
                    if not self._waiting and self.buf.startswith("/"):
                        matches = self._matches()
                        if len(matches) == 1:
                            self.buf = matches[0]
                        elif matches:
                            self._sel = (self._sel + 1) % len(matches)
                            self.buf = matches[self._sel]
                        self._hidden = True
                        self._draw()
                    elif self._waiting:
                        sys.stdout.write("  ")
                        sys.stdout.flush()
                elif ch == 0x04:
                    pending = pending[1:]
                    self._clear_area()
                    put(None)
                    return
                elif ch in (0x7F, 0x08):
                    pending = pending[1:]
                    if self.buf:
                        self.buf = self.buf[:-1]
                        if self._waiting:
                            sys.stdout.write("\b \b")
                            sys.stdout.flush()
                        else:
                            self._sel = 0
                            self._draw()
                elif 32 <= ch < 127:
                    c = pending[:1].decode()
                    pending = pending[1:]
                    if len(self.buf) < 4096:
                        self.buf += c
                        if self._waiting:
                            sys.stdout.write(c)
                            sys.stdout.flush()
                        else:
                            self._hidden = False
                            self._sel = 0
                            self._draw()
                else:
                    pending = pending[1:]


def _restore_term(old) -> None:
    try:
        tty.tcsetattr(sys.stdin.fileno(), tty.TCSAFLUSH, old)
    except Exception:
        pass


def _is_retryable(exc: Exception) -> bool:
    msg = str(exc).lower()
    return ("503" in msg or "unavailable" in msg or "high demand" in msg
            or "429" in msg or "quota" in msg or "resource exhausted" in msg
            or "load" in msg and "retry" in msg or "rate limit" in msg)


def _retry_delay(exc: Exception, default: float = RETRY_DELAY) -> float:
    import re
    m = re.search(r"retry in\s+([\d.]+)s?", str(exc), re.IGNORECASE)
    if m:
        return max(0.5, float(m.group(1)) + 0.5)
    m = re.search(r"retrydelay['\"]?:\s*['\"]?([\d.]+)s", str(exc), re.IGNORECASE)
    if m:
        return max(0.5, float(m.group(1)) + 0.5)
    return default


def provider_iter_content(provider, contents, config):
    """Itera chunks compatibles con el bucle de nex.

    Usa streaming si el provider lo soporta (`generate_content_stream`, solo
    Gemini hoy); si no, envuelve `generate_content` en un único chunk con
    texto y function_calls para que el resto del bucle sea provider-agnóstico.
    """
    stream_fn = getattr(provider, "generate_content_stream", None)
    if stream_fn is not None:
        yield from stream_fn(contents=contents, config=config)
        return

    response = provider.generate_content(contents=contents, config=config)
    parts = []
    text = getattr(response, "text", None)
    if text:
        parts.append(type("Part", (), {"text": text})())
    for fc in getattr(response, "function_calls", None) or []:
        parts.append(type("Part", (), {"function_call": fc})())
    content = type("Content", (), {"parts": parts})()
    candidate = type("Candidate", (), {"content": content})()
    yield type("Chunk", (), {"candidates": [candidate]})()


def parse_connect_text(text: str) -> tuple[str | None, dict]:
    """Parsea '<provider> [--key K] [--url U] [--model M] [--start]' desde el chat."""
    tokens = text.split()
    target = None
    flags: dict = {}
    i = 0
    while i < len(tokens):
        t = tokens[i]
        if i == 0 and not t.startswith("-"):
            target = t
        elif t == "--start":
            flags["start"] = True
        elif t in ("--key", "--url", "--model") and i + 1 < len(tokens):
            flags[t[2:]] = tokens[i + 1]
            i += 1
        i += 1
    if not flags:
        # sin flags: dos primeras palabras = provider y modelo (forma corta)
        if target and len(tokens) >= 2 and not tokens[1].startswith("-"):
            flags["model"] = tokens[1]
    return target, flags


