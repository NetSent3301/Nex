            level=os.environ.get("NEX_LOG_LEVEL", "WARNING").upper(),
            format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
        )
    # Silenciar loggers ruidosos de terceros (HTTP request/response de los SDKs).
    for _noisy in ("httpx", "httpcore", "urllib3", "openai", "anthropic", "google"):
        logging.getLogger(_noisy).setLevel(logging.WARNING)

    lang = get_settings().get("language", "es")
    base_system_prompt = build_system_prompt(workspace_root=ws, language=lang)
    goal = None

    registry = create_default_registry()

    hooks_loaded = load_user_hooks()
    if hooks_loaded:
        print(f"  {G}🔌 {hooks_loaded} hooks de usuario cargados{RS}")
    run_hooks("session_start", workspace=ws, lang=lang, goal=goal)

    historial_previo = load_chat_history("cli", workspace=ws)
    historial_previo = trim_messages(historial_previo, MAX_HISTORY_MESSAGES)
    chat_history = list(historial_previo)

    if historial_previo:
        print(f"  {M}📜 {len(historial_previo)} mensajes del historial recuperados{RS}")
    elif get_history_workspace("cli"):
        print(f"  {Y}🔄 El historial previo era de otro workspace y se ha ignorado{RS}")

    spinner = Spinner()

    # ── Entrada de comandos en segundo plano (permite /stop durante ejecución) ──
    cmd_queue = queue.Queue()
    interactive = sys.stdin.isatty()
    term_input = TermInput(prompt=f"{B}Tu> {RS}")

    def _reader():
        if interactive:
            term_input.run(cmd_queue.put)
        else:
            while True:
                line = sys.stdin.readline()
                if not line:
                    cmd_queue.put(None)
                    return
                cmd_queue.put(line.rstrip("\n"))

    reader_thread = threading.Thread(target=_reader, daemon=True)
    reader_thread.start()

    def read_command():
        while True:
            try:
                return cmd_queue.get(timeout=0.25)
            except queue.Empty:
                if not reader_thread.is_alive():
                    return None

    def stop_requested() -> bool:
        pending = []
        while True:
            try:
                pending.append(cmd_queue.get_nowait())
            except queue.Empty:
                break
        stopped = any(line == "/stop" for line in pending)
        for line in pending:
            if line != "/stop":
                cmd_queue.put(line)
        return stopped

    # ── Prompt de sistema dinámico (incluye el objetivo activo) ──
    def make_system_prompt():
        extra = ""
        if goal:
            extra = (
                "\n\n[OBJETIVO ACTIVO]\n"
                f"- Meta principal del usuario: {goal}\n"
                "- Orienta tus acciones y recomendaciones hacia esa meta.\n"
            )
        return base_system_prompt + extra

    def stream_with_retry(chat_history, config, spinner):
        for attempt in range(RETRIES_503):
            try:
                yield from provider_iter_content(provider, chat_history, config)
                return
            except Exception as e:
                if not _is_retryable(e):
                    raise
                delay = _retry_delay(e)
                km = getattr(provider, "_key_manager", None)
                if km is not None and ("429" in str(e) or "quota" in str(e).lower() or "exhausted" in str(e).lower()):
                    try:
                        km.handle_error(e, cooldown=int(delay))
                        provider._rebuild_client()
                    except Exception:
                        pass
                km_str = f"{km.current_key[:8]}..." if km is not None else "?"
                print(f"  {Y}⚠️  API ocupada, reintentando en {delay:.0f}s ({attempt+1}/{RETRIES_503}) [clave: {km_str}]{RS}")
                spinner.stop()
                spinner.start("Esperando a la API...")
                time.sleep(min(delay, RETRY_MAX_SLEEP))
        raise RuntimeError(f"La API no respondió tras {RETRIES_503} intentos (quota/ocupada)")

    def ask(chat_history, config):
        """Stream una respuesta completa; devuelve (parts, function_calls, header_printed, text)."""
        parts = []
        function_calls = []
        text_buffer = ""
        for chunk in stream_with_retry(chat_history, config, spinner):
            if stop_requested():
                raise StopInterrupt()
            if not chunk.candidates:
                continue
            content = chunk.candidates[0].content
            if not content or not content.parts:
                continue
            for p in content.parts:
                if p is None:
                    continue
                if getattr(p, "text", None):
                    text_buffer += p.text
                    parts.append(p)
                fc = getattr(p, "function_call", None)
                if fc is not None:
                    function_calls.append(fc)
                    parts.append(p)
        return parts, function_calls, bool(text_buffer), text_buffer

    def execute_turn(user_text):
        chat_history.append(types.Content(role="user", parts=[types.Part.from_text(text=user_text)]))
        run_hooks("turn_start", user_text=user_text)

        config = types.GenerateContentConfig(
            system_instruction=make_system_prompt(),
            tools=registry.get_all_tools_metadata(),
            temperature=0.2,
        )

        tool_calls = 0
        try:
            for _ in range(MAX_ITERATIONS):
                spinner.start("Pensando...")
                try:
                    parts, function_calls, header_printed, text = ask(chat_history, config)
                finally:
                    spinner.stop()
                if text:
                    sys.stdout.write(f"\n{G}🤖 [Nex]:{RS}\n")
                    sys.stdout.flush()
                    console.print(Markdown(text))

                if not parts:
                    if not header_printed:
                        print(f"{Y}⚠️  El modelo no devolvió contenido; reintentando...{RS}")

                assistant_content = types.Content(role="model", parts=parts)
                chat_history.append(assistant_content)

                if not function_calls:
                    print()
                    save_chat_history(chat_history, "cli", workspace=ws)
                    run_hooks("turn_end", user_text=user_text,
                              tool_calls=tool_calls, success=True, error=None)
                    return

                for call in function_calls:
                    if stop_requested():
                        raise StopInterrupt()
                    tool_name = call.name
                    tool_args = dict(call.args)
                    tool_args["workspace_root"] = ws
                    args_repr = ", ".join(f"{k}={str(v)[:40]}" for k, v in dict(call.args).items())

                    run_hooks("tool_before", name=tool_name, args=tool_args)
                    spinner.start(f"Ejecutando {tool_name}...")
                    t0 = time.time()
                    try:
                        tool = registry.get(tool_name)
                        raw = tool.execute(**tool_args)
                    except Exception as e:
                        raw = {"success": False, "error": str(e)}
                    duration = time.time() - t0
                    spinner.stop()
                    tool_result, issues = validate_tool_result(tool_name, raw)
                    ok = tool_result.get("success") is not False
                    print(f"  {B}🛠️  {W}{tool_name}{C}({args_repr}){G if ok else R} {'✓' if ok else '✗'}{RS} {M}{duration:.2f}s{RS}")
                    if issues:
                        print(f"  {Y}⚠️  [{tool_name}] {'; '.join(issues)}{RS}")
                    tool_calls += 1
                    run_hooks("tool_after", name=tool_name, args=tool_args,
                              result=tool_result, duration_s=duration,
                              issues=issues, success=ok)
                    chat_history.append(types.Content(
                        role="user",
                        parts=[types.Part.from_function_response(name=tool_name, response=tool_result)],
                    ))
            else:
                print(f"{Y}⚠️  Límite de iteraciones alcanzado.{RS}")
                save_chat_history(chat_history, "cli", workspace=ws)
                run_hooks("turn_end", user_text=user_text,
                          tool_calls=tool_calls, success=False, error="límite de iteraciones")
        except StopInterrupt:
            print(f"\n{Y}⏹️  Ejecución interrumpida.{RS}")
            run_hooks("turn_end", user_text=user_text,
                      tool_calls=tool_calls, success=False, error="interrumpido")
        except KeyboardInterrupt:
            print(f"\n{Y}⏹️  Cancelado.{RS}")
        except Exception as e:
            print(f"\n{R}❌ Error: {e}{RS}")
            if "API key" in str(e) or "403" in str(e):
                print(f"{Y}💡 Verifica GEMINI_API_KEY en .env{RS}")
            save_chat_history(chat_history, "cli", workspace=ws)
            run_hooks("turn_end", user_text=user_text,
                      tool_calls=tool_calls, success=False, error=str(e))

    # ── Helpers de los comandos ──
    def show_help():
        print(f"""{C}Comandos disponibles:{RS}
  {B}/new{RS} o {B}/reset{RS}    Nueva sesión, contexto fresco (borra historial y objetivo)
  {B}/stop{RS}             Detener la ejecución del agente en curso
  {B}/compact{RS}          Comprimir el contexto de la conversación
  {B}/help{RS}             Este listado
  {B}/status{RS}           Ver estado (modelo, claves, mensajes, objetivo)
  {B}/model <nombre>{RS}   Cambiar modelo en caliente (ej: gemini-2.5-pro, /model list)
  {B}/providers{RS}        Ver estado de todos los proveedores LLM
  {B}/connect <p>{RS}      Conectar y activar un provider (/connect ollama gemma3:1b,
                           flags: --key K --url U --model M --start)
  {B}/use <p> [m]{RS}      Cambiar de provider/modelo solo para esta sesión
  {B}/traces [n]{RS}       Ver las últimas n trazas/ejecuciones de tools
  {B}/retry{RS}            Reintentar la última pregunta
  {B}/undo{RS}             Quitar el último intercambio
  {B}/goal <texto>{RS}     Definir un objetivo que el agente persigue (/goal clear para borrar)
  {B}/tools{RS}            Listar herramientas disponibles
  {B}/clear{RS}            Limpiar el historial de la sesión
  {B}exit{RS}              Salir""")

    def show_input_hint():
        console.print(f"  {M}💡 En el prompt escribe '/' y se abre una ventana flotante encima con el autocompletado (↑/↓ navega, Tab completa, Enter acepta).{RS}")

    def history_to_text(history) -> str:
        lines = []
        for c in history:
            role = c.role
            label = "Usuario" if role == "user" else ("Asistente" if role == "model" else role)
            texts = [p.text for p in getattr(c, "parts", []) if getattr(p, "text", None)]
            if texts:
                lines.append(f"{label}: {' '.join(texts)}")
        return "\n".join(lines)

    def history_chars(history) -> int:
        total = 0
        for c in history:
            for p in getattr(c, "parts", []):
                text = getattr(p, "text", None)
                if text:
                    total += len(text)
        return total

    def last_user_turn(history):
        for i in range(len(history) - 1, -1, -1):
            c = history[i]
            if getattr(c, "role", None) == "user" and any(
                getattr(p, "text", None) for p in getattr(c, "parts", [])
            ):
                return i
        return None

    def do_compact():
        nonlocal chat_history
        if not chat_history:
            print(f"{Y}⚠️  No hay conversación que comprimir.{RS}")
            return
        dump = history_to_text(chat_history)
        prompt = (
            "Resume la conversación en un resumen compacto en el idioma del usuario "
            "(máximo 200 palabras). Conserva los objetivos, decisiones técnicas, "
            "archivos tocados y lo que queda pendiente. NO inventes hechos:\n\n"
            f"{dump}"
        )
        spinner.start("Comprimiendo contexto...")
        try:
            resp = provider.generate_content(
                contents=[types.Content(role="user", parts=[types.Part.from_text(text=prompt)])],
                config=types.GenerateContentConfig(
                    system_instruction=make_system_prompt(), temperature=0.2
                ),
            )
            summary = (resp.text or "").strip()
        except Exception as e:
            spinner.stop()
            print(f"{R}❌ No se pudo comprimir el contexto: {e}{RS}")
            return
        spinner.stop()
        if not summary:
            print(f"{Y}⚠️  Resumen vacío; el contexto no cambia.{RS}")
            return
        chat_history = [
            types.Content(
                role="user",
                parts=[types.Part.from_text(text=f"[CONTEXTO COMPRIMIDO DE SESIONES ANTERIORES]\n{summary}")],
            )
        ]
        save_chat_history(chat_history, "cli", workspace=ws)
        print(f"{G}✓ Contexto comprimido ({len(summary.split())} palabras).{RS}")

    def do_status():
        print(f"{C}Estado del agente:{RS}")
        print(f"  Modelo:          {provider.model}")
        print(f"  Workspace:       {ws}")
        print(f"  Idioma:          {lang}")
        chars = history_chars(chat_history)
        print(f"  Mensajes:        {len(chat_history)}  (~{chars} caracteres, ≈{chars // 4} tokens estimados)")
        km = getattr(provider, "_key_manager", None)
        if km is not None:
            print(f"  API keys:        {km.key_count} disponibles (actual: {W}{km.current_key[:8]}...{RS})")
        else:
            print("  API keys:        —")
        print(f"  Objetivo activo: {goal or '(ninguno)'}")
        print(f"  Hooks:           {sum(len(v) for v in _HOOKS.values())} ({','.join(_HOOKS.keys())})")
        if os.path.isfile(TRACES_FILE):
            try:
                with open(TRACES_FILE, "r", encoding="utf-8") as f:
                    trace_count = len(f.read().splitlines())
            except OSError:
                trace_count = 0
            print(f"  Trazas:          {trace_count} registradas (ver /traces)")

    # ── Bucle principal ──
    try:
        while True:
            if interactive:
                term_input.ask()
            else:
                sys.stdout.write(f"{B}Tu> {RS}")
                sys.stdout.flush()

            user_input = read_command()
            if user_input is None:
                print(f"\n{W}👋 Goodbye!{RS}")
                run_hooks("session_end", workspace=ws)
                save_chat_history(chat_history, "cli", workspace=ws)
                break
            user_input = user_input.strip()
            if not user_input:
                continue

            cmd = user_input.split()[0].lower()

            if cmd in ("exit", "quit"):
                print(f"{W}👋 Goodbye!{RS}")
                run_hooks("session_end", workspace=ws)
                save_chat_history(chat_history, "cli", workspace=ws)
                break
            elif cmd == "/help":
                show_help()
                show_input_hint()
            elif cmd == "/tools":
                print(f"{C}Herramientas ({len(registry.list_tools())}):{RS}")
                for i, t in enumerate(registry.list_tools(), 1):
                    print(f"  {B}{i:2d}.{RS} {t}")
            elif cmd in ("/new", "/reset"):
                chat_history = []
                goal = None
                save_chat_history(chat_history, "cli", workspace=ws)
                print(f"{G}✓ Nueva sesión con contexto fresco.{RS}")
            elif cmd == "/clear":
                chat_history = []
                print(f"{G}✓ Historial de la sesión limpio.{RS}")
            elif cmd == "/status":
                do_status()
            elif cmd == "/traces":
                parts = user_input.split()
                try:
                    n = int(parts[1]) if len(parts) > 1 else 8
                except ValueError:
                    n = 8
                if not os.path.isfile(TRACES_FILE):
                    print(f"{Y}⚠️  No hay trazas registradas aún.{RS}")
                else:
                    try:
                        with open(TRACES_FILE, "r", encoding="utf-8") as f:
                            lines = f.read().splitlines()
                    except OSError:
                        lines = []
                    if not lines:
                        print(f"{Y}⚠️  No hay trazas registradas aún.{RS}")
                        continue
                    print(f"{C}Últimas trazas ({min(n, len(lines))}):{RS}")
                    for line in lines[-n:]:
                        try:
                            e = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        ts = time.strftime("%H:%M:%S", time.localtime(e.get("ts", time.time())))
                        mark = "✓" if e.get("success") else "✗"
                        issues = " ⚠️" if e.get("issues") else ""
                        print(f"  {B}{ts}{RS} {mark} {W}{e.get('tool')}{RS} {e.get('duration_s')}s{M}{issues}{RS}")
            elif cmd == "/stop":
                print(f"{G}✓ Sin ejecución en curso; nada que detener.{RS}")
            elif cmd == "/undo":
                idx = last_user_turn(chat_history)
                if idx is None:
                    print(f"{Y}⚠️  No hay intercambio que deshacer.{RS}")
                else:
                    removed = len(chat_history) - idx
                    del chat_history[idx:]
                    save_chat_history(chat_history, "cli", workspace=ws)
                    print(f"{G}✓ Último intercambio eliminado ({removed} mensajes).{RS}")
            elif cmd == "/retry":
                idx = last_user_turn(chat_history)
                if idx is None:
                    print(f"{Y}⚠️  No hay nada que reintentar.{RS}")
                    continue
                last_text = next(
                    (p.text for p in chat_history[idx].parts if getattr(p, "text", None)), ""
                )
                del chat_history[idx:]
                if not last_text:
                    print(f"{Y}⚠️  La última intervención no tiene texto.{RS}")
                    continue
                print(f"{M}↻ Reintentando: {W}{last_text}{RS}")
                execute_turn(last_text)
            elif cmd == "/model":
                parts = user_input.split()
                if len(parts) >= 2 and parts[1] in ("list", "ls"):
                    print(f"{C}Modelos disponibles:{RS}")
                    for m in provider.list_models():
                        print(f"  {B}{m}{RS}")
                elif len(parts) >= 2:
                    provider.model = parts[1]
                    print(f"{G}✓ Modelo cambiado a: {W}{provider.model}{RS}")
                else:
                    print(f"{G}Modelo actual: {W}{provider.model}{RS}")
            elif cmd == "/providers":
                cmd_providers()
            elif cmd == "/connect":
                from llm.connect import (
                    PROVIDERS,
                    connect_provider,
                    provider_status,
                    start_freellm,
                )

                target, flags = parse_connect_text(user_input[len("/connect"):].strip())
                if not target or target not in PROVIDERS:
                    print(f"{R}❌ Uso: /connect <provider> [--key K] [--url U] [--model M] [--start]{RS}")
                    print(f"{Y}💡 Disponibles: {W}{', '.join(PROVIDERS)}{RS}")
                    continue
                st = provider_status(target)
                print(f"{C}Conectando {W}{target}{RS} — {PROVIDERS[target]['label']} ({PROVIDERS[target]['kind']})")
                if (
                    st["kind"] == "local"
                    and not st["reachable"]
                    and target == "freellm"
                    and flags.get("start")
                ):
                    print(f"  {C}→{RS} Arrancando FreeLLM...")
                    proc, msg = start_freellm()
                    print(f"  {msg}")
                try:
                    result = connect_provider(
                        target,
                        api_key=flags.get("key"),
                        base_url=flags.get("url"),
                        model=flags.get("model"),
                    )
                except RuntimeError as e:
                    print(f"{R}❌ {e}{RS}")
                    continue
                for step in result["steps"]:
                    print(f"  {G}✓{RS} {step}")
                try:
                    provider = build_provider(target)
                except Exception as e:
                    print(f"{Y}⚠️  Conectado, pero no se pudo activar en esta sesión: {e}{RS}")
                    continue
                print(f"{G}✅ {target} activo en esta sesión{RS} — {W}{provider.model}{RS}")
            elif cmd == "/use":
                from llm.connect import PROVIDERS

                parts = user_input.split()
                name = parts[1] if len(parts) > 1 else ""
                model = parts[2] if len(parts) > 2 else None
                if name not in PROVIDERS:
                    print(f"{R}❌ Provider desconocido: {W}{name}{RS}  Disponibles: {', '.join(PROVIDERS)}{RS}")
                    continue
                try:
                    provider = build_provider(name, model)
                except Exception as e:
                    print(f"{R}❌ No se pudo usar {name}: {e}{RS}")
                    continue
                print(f"{G}✓ Sesión cambiada a: {W}{name} · {provider.model}{RS} (no persiste; usa /connect para guardarlo)")
            elif cmd == "/goal":
                rest = user_input[len(cmd):].strip()
                if not rest:
                    if goal:
                        print(f"{G}Objetivo activo: {W}{goal}{RS}")
                    else:
                        print(f"{Y}Uso: /goal <texto>   (o /goal clear para borrarlo){RS}")
                elif rest.lower() in ("clear", "ninguno", "none"):
                    goal = None
                    print(f"{G}✓ Objetivo borrado.{RS}")
                else:
                    goal = rest
                    print(f"{G}✓ Objetivo definido: {W}{goal}{RS}")
            elif cmd == "/compact":
                do_compact()
            elif cmd.startswith("/"):
                print(f"{Y}⚠️  Comando desconocido: {W}{cmd}{Y}   (prueba /help){RS}")
            else:
                execute_turn(user_input)
    except KeyboardInterrupt:
        print(f"\n{W}👋 Goodbye!{RS}")
        run_hooks("session_end", workspace=ws)
        save_chat_history(chat_history, "cli", workspace=ws)


def cmd_providers():
    from llm.connect import all_providers_status

    print(f"{C}Proveedores LLM:{RS}")
    print(f"  {'Provider':<12} {'Estado':<28} Detalles")
    for st in all_providers_status():
        name = st["name"]
        if st["kind"] == "local":
            if st["reachable"]:
                state = f"{G}✓{RS} accesible"
                models = ", ".join(st["models"][:6]) or "sin modelos"
            else:
                state = f"{R}✗{RS} sin conexión"
                models = st["base_url"]
            status_line = f"{state}  {M}{models}{RS}"
        else:
            if st["configured"]:
                state = f"{G}✓{RS} key {C}{st['key_masked']}{RS}"
                models = ", ".join(st["models"][:6]) or "—"
            else:
                state = f"{Y}⚠️  sin API key{RS}"
                models = f"({st['base_url'] or 'cloud'})".replace("()", "")
            status_line = f"{state}  {M}{models}{RS}"
        active = f" {B}← activo{RS}" if st["active"] else ""
        print(f"  {W}{name:<12}{RS} {status_line}{active}")
    print(f"\n{C}Conectar:{RS}  nex connect <provider> [--key K] [--url URL] [--model M] [--start]")


def cmd_connect(target: str | None, args) -> None:
    from llm.connect import PROVIDERS, connect_provider, provider_status, start_freellm

    if not target:
        print(f"{R}❌ Uso: nex connect <provider>  (disponibles: {', '.join(PROVIDERS)}){RS}")
        return
    if target not in PROVIDERS:
        print(f"{R}❌ Provider '{target}' desconocido. Disponibles: {', '.join(PROVIDERS)}{RS}")
        return

    info = PROVIDERS[target]
    st = provider_status(target)
    print(f"{C}Conectando {W}{target}{RS} — {info['label']} ({info['kind']})")
    if info.get("env_var"):
        if st["configured"]:
            hint = f" ({st['key_masked']})" if st.get("key_masked") else ""
            print(f"  {G}✓{RS} API key configurada{hint}")
        else:
            print(f"  {Y}⚠️  sin API key configurada{RS}")

    if info["kind"] == "local" and not st["reachable"]:
        print(f"  {R}✗{RS} no accesible en {st['base_url']}")
        if target == "freellm":
            if args.start:
                print(f"  {C}→{RS} Arrancando FreeLLM...")
                proc, msg = start_freellm()
                print(f"  {msg}")
                if proc is None or proc.poll() is not None:
                    print(f"{R}❌ FreeLLM no está disponible tras el arranque.{RS}")
                    return
            else:
                answer = input(f"  ¿Arrancar FreeLLM ahora? [y/N] ").strip().lower()
                if answer != "y":
                    print(f"{Y}💡 Prueba: nex connect freellm --start   o  ./start-freellm.sh{RS}")
                    return
                proc, msg = start_freellm()
                print(f"  {msg}")
    elif st["reachable"]:
        print(f"  {G}✓{RS} accesible en {st['base_url']}")

    if info["kind"] == "cloud" and not st["configured"] and not args.key:
        api_key = input(f"  {C}API key para {target} (no se muestra):{RS} ").strip()
        if not api_key:
            print(f"{R}❌ Sin API key no se puede conectar {target}.{RS}")
            return
        args.key = api_key

    try:
        result = connect_provider(
            target,
            api_key=args.key,
            base_url=args.url,
            model=args.model,
        )
    except RuntimeError as e:
        print(f"{R}❌ {e}{RS}")
        return

    for step in result["steps"]:
        print(f"  {G}✓{RS} {step}")
    st = result["status"]
    print(f"\n{G}✅ {target} conectado{RS} — proveedor activo."
          f" Prueba: {B}nex chat --provider {target}{RS}")


def main():
    parser = argparse.ArgumentParser(prog="nex", description="Nex - AI-powered coding assistant")
    parser.add_argument("command", nargs="?", choices=["chat", "version", "set-workspace", "providers", "connect", "help"], default="chat")
    parser.add_argument("target", nargs="?", help="Provider para 'connect' (freellm, ollama, gemini, openai, anthropic, deepseek)")
    parser.add_argument("--provider", default=None, help="Provider para el chat (si no, el configurado en settings)")
    parser.add_argument("--model", default=None, help="Modelo a usar")
    parser.add_argument("--key", default=None, help="API key del provider (solo 'connect')")
    parser.add_argument("--url", default=None, help="Base URL del provider (solo 'connect'; FreeLLM/Ollama)")
    parser.add_argument("--start", action="store_true", help="Arrancar FreeLLM si no responde (solo 'connect freellm')")
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--no-frontend", action="store_true")
